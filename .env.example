# Example .env for ztdns (DO NOT store real secrets in repo)
# Real environment variables override values in this file.

# Required
ZTDNS_ZT_API=REPLACE_WITH_YOUR_ZEROTIER_API_TOKEN
ZTDNS_ZT_URL=https://my.zerotier.com/api
ZTDNS_NETWORKS=example=0123456789abcdef,corp=9876543210abcd

# Optional
ZTDNS_SUFFIX=zt
ZTDNS_PORT=53
ZTDNS_INTERFACE=zt0
ZTDNS_DBREFRESH=30
